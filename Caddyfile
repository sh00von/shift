# Caddy runs as internal HTTP-only proxy — TLS is terminated by Dokploy/Traefik upstream.
:6677 {
    # Backend — REST + WebSocket
    handle /api/* {
        reverse_proxy backend:7766 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            # WebSocket upgrade support
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # Frontend — Next.js
    handle {
        reverse_proxy frontend:6767 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
